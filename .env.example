# Database
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/menu_stories?appName=Cluster0

# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Public base URL encoded into QR codes. PERMANENT once codes are printed.
APP_URL=http://localhost:3000

# Cloudinary (server). NEXT_PUBLIC_* mirrors are derived in next.config.ts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=                # optional. Uploads are fully signed, so no preset (and no Cloudinary account change) is needed

# First staff user (used by scripts/create-admin.ts and the seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Translation. TranslationProvider is pluggable; Mistral is the default.
TRANSLATION_PROVIDER=deepl                # deepl (default) | mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-2512          # "fast" engine (languages the quality test has cleared)
MISTRAL_MODEL_STRONG=ministral-14b-2512  # "strong" engine (default for non-European languages)
TRANSLATION_CONCURRENCY=2
TRANSLATION_JUDGE_MODEL=                 # optional: LLM judge used only by `npm run quality` (e.g. ministral-14b-2512)

# Translation: DeepL is the default engine (a dedicated translation API: deterministic, cannot invent text).
# Free keys end in ":fx" (500k characters/month). Set TRANSLATION_PROVIDER=mistral to use the LLM fallback.
DEEPL_API_KEY=
